# Site URL (used for any absolute links / sitemaps)
SITE_URL=https://nearinsanity.com

# Backend API base for the frontend.
# - Leave empty (default) for production: nginx routes /api/ to Django on
#   the same origin.
# - Local frontend dev (Vite on 5178) should point at the local backend,
#   e.g. VITE_API_BASE=http://127.0.0.1:8001 (see .env.local).
VITE_API_BASE=

# Unused by the frontend today (the Django backend runs on its own port,
# see backend/.env.example)
PORT=5000