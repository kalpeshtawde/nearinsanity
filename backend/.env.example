# Template for environment-specific secrets. Copy to `.env` (local) or fill
# in on the server (production) — never commit real values.
#
#   cp .env.example .env   # local dev

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5178

# PostgreSQL
# Local dev: the postgres:15 container (docker-compose.db.yml) on port 5441.
# Production: the server's physical Postgres 15 — same variable names,
# different host/port/credentials.
# Note: when the backend runs in Docker, DB_HOST is overridden to
# host.docker.internal by docker-compose.prod.yml (a container's localhost
# is itself); the value below only applies to host-run Django.
DB_NAME=nearinsanity
DB_USER=nearinsanity
DB_PASSWORD=nearinsanity_dev
DB_HOST=127.0.0.1
DB_PORT=5441