# Production environment template — copy to the server as backend/.env and
# fill in real values. The server runs Django against its physical Postgres 15
# (no Docker container for the DB).

# Django — generate a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=nearinsanity.com,www.nearinsanity.com

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=https://nearinsanity.com

# PostgreSQL — the server's physical instance.
# DB_HOST is overridden to host.docker.internal by docker-compose.prod.yml
# for the container; kept here for completeness.
DB_NAME=REPLACE
DB_USER=REPLACE
DB_PASSWORD=REPLACE
DB_HOST=127.0.0.1
DB_PORT=5432